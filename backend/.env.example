# Server (lokal non-Vercel)
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Prisma)
# Gunakan pooled connection URL untuk DATABASE_URL (penting di Vercel serverless)
# dan direct connection URL untuk DIRECT_URL (dibutuhkan Prisma migrate).
DATABASE_URL="postgresql://user:password@host:5432/web_toko_sepatu?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/web_toko_sepatu?sslmode=require"

# Auth JWT
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter"

# Frontend URL untuk callback Midtrans (opsional di Vercel karena otomatis pakai domain Vercel)
FRONTEND_URL="http://localhost:3000"

# Cloudinary (penyimpanan gambar produk, avatar, & testimoni)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Midtrans Payment Gateway
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
