# Kosongkan saat memakai Vercel Services (vercel dev / deploy 1 project di Vercel)
# karena request langsung mengarah ke same-origin (/api/...).
# Aktifkan hanya jika menjalankan frontend & backend secara terpisah di lokal:
# NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_API_URL=""

# Midtrans Snap Client Key (sandbox / production sesuai mode backend)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
